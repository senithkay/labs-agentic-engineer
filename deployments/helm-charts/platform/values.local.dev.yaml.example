# Per-developer overrides for the AEP platform chart, layered LAST (after
# values.yaml and values.local.yaml) by skaffold.yaml — so anything here wins.
#
#   cp values.local.dev.yaml.example values.local.dev.yaml   # git-ignored
#   # edit, then: make dev-cluster
#
# This mirrors the aectl config model (webhook.delivery_url / webhook.local_smee
# imported into the aep-cli-config ConfigMap via 'aep platform config import'):
# the developer supplies the delivery URL — nothing is auto-created. Put any
# local-only chart overrides here (images, replicas, flags).

# ── GitHub webhook delivery (component builds on PR merge) ───────────────────
# Builds are triggered by a GitHub push/merge webhook hitting the BFF. GitHub
# cannot reach a local k3d cluster directly, so relay through a smee.io channel
# (a third-party public relay — LOCAL DEV ONLY; payloads transit it and the
# channel URL is an unauthenticated bearer link) into an in-cluster smee-client.
#
# 1. Mint a channel (stable — reuse it so repo webhook registrations stay valid):
#      curl -s https://smee.io/new -o /dev/null -w '%{redirect_url}\n'
# 2. Paste it as deliveryURL below and set localSmee.enabled: true.
# 3. make dev-cluster
#
# NOTE: the BFF registers a repo webhook at PROJECT-CREATE time. Set this BEFORE
# creating the project whose builds you want to auto-trigger.
webhook:
  deliveryURL: "https://smee.io/REPLACE_WITH_YOUR_CHANNEL"
  localSmee:
    enabled: true
