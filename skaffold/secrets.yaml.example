# Local dev secrets for the Skaffold deploy path.
# Copy this file to skaffold/secrets.yaml and fill in the Thunder admin credentials.
# skaffold/secrets.yaml is gitignored — never commit it.
# aep-task-signing-key is auto-generated by skaffold/generate-and-apply.sh on first deploy.
apiVersion: v1
kind: Secret
metadata:
  name: aep-thunder-admin-creds
  namespace: wso2-aep
type: Opaque
stringData:
  client-id: "<thunder-admin-client-id>"
  client-secret: "<thunder-admin-client-secret>"
---
apiVersion: v1
kind: Secret
metadata:
  name: aep-agents-secrets
  namespace: wso2-aep
type: Opaque
stringData:
  AGENTS_JWT_SECRET: "dev-agents-jwt-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: aep-webhook-secrets
  namespace: wso2-aep
type: Opaque
stringData:
  GITHUB_WEBHOOK_SECRET: "dev-webhook-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: wso2-aep
type: Opaque
stringData:
  POSTGRES_PASSWORD: "dev-postgres-password"
---
apiVersion: v1
kind: Secret
metadata:
  name: aep-oauth-secrets
  namespace: wso2-aep
type: Opaque
stringData:
  OAUTH_STATE_SIGNING_KEY: "dev-oauth-state-signing-key"
---
apiVersion: v1
kind: Secret
metadata:
  name: aep-thunder-secrets
  namespace: wso2-aep
type: Opaque
stringData:
  OC_WORKLOAD_PUBLISHER_SECRET: "openchoreo-workload-publisher-secret"
  OC_OBSERVER_READER_SECRET: "openchoreo-observer-resource-reader-client-secret"
  AEP_API_CLIENT_SECRET: "aep-api-client-secret"
  BFF_TO_GIT_SERVICE_SECRET: "aep-bff-to-git-service-secret"
  BFF_TO_REMOTE_WORKER_SECRET: "aep-bff-to-remote-worker-secret"
  LOCAL_DEV_SEEDER_SECRET: "aep-local-dev-seeder-secret"
  THUNDER_SYSTEM_CLIENT_SECRET: "aep-system-client-secret"
  OC_RCA_AGENT_SECRET: "openchoreo-rca-agent-secret"
---
# Credentials for the thunder-app-operator. Must match aep-system-client
# registered in Thunder (THUNDER_SYSTEM_CLIENT_SECRET above).
# In production these are synced from OpenBao via ESO; here they are plain
# K8s Secrets (localSecrets path).
apiVersion: v1
kind: Secret
metadata:
  name: thunder-app-operator-credentials
  namespace: thunder-app-operator-system
type: Opaque
stringData:
  client-id: "aep-system-client"
  client-secret: "aep-system-client-secret"
